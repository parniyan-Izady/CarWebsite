@using CarWashWebsite.Data.Entities
@model CarWashWebsite.ViewModels.Admin.ServiceFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create New Service";
}

<div class="max-w-4xl">
    <div class="mb-6 flex items-center justify-between">
        <a href="/Admin/Services" class="text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors">
            &larr; Back to Services List
        </a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 lg:p-8">
        <form asp-area="Admin" asp-controller="Services" asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-8">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-red-50 text-red-700 text-sm border border-red-200"></div>

            <!-- Section: Titles & Descriptions -->
            <div>
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-4">1. Multilingual Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div>
                            <label asp-for="TitleDe" class="block text-xs font-bold text-slate-700 mb-1">Title (German) *</label>
                            <input asp-for="TitleDe" required class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none" />
                            <span asp-validation-for="TitleDe" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="DescriptionDe" class="block text-xs font-bold text-slate-700 mb-1">Description (German) *</label>
                            <textarea asp-for="DescriptionDe" rows="4" class="ckeditor w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none"></textarea>
                            <span asp-validation-for="DescriptionDe" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label asp-for="TitleEn" class="block text-xs font-bold text-slate-700 mb-1">Title (English) *</label>
                            <input asp-for="TitleEn" required class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none" />
                            <span asp-validation-for="TitleEn" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="DescriptionEn" class="block text-xs font-bold text-slate-700 mb-1">Description (English) *</label>
                            <textarea asp-for="DescriptionEn" rows="4" class="ckeditor w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none"></textarea>
                            <span asp-validation-for="DescriptionEn" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section: Pricing & Ordering -->
            <div class="pt-6 border-t border-slate-200">
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-4">2. Pricing & Visibility</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    <div>
                        <label asp-for="Price" class="block text-xs font-bold text-slate-700 mb-1">Price (€)</label>
                        <input asp-for="Price" type="number" step="0.01" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none" />
                    </div>
                    <div>
                        <label asp-for="PriceType" class="block text-xs font-bold text-slate-700 mb-1">Price Type</label>
                        <select asp-for="PriceType" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none">
                            <option value="@PriceType.StartingFrom">Starting From (ab €)</option>
                            <option value="@PriceType.Fixed">Fixed Price (€)</option>
                            <option value="@PriceType.OnRequest">On Request</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="DisplayOrder" class="block text-xs font-bold text-slate-700 mb-1">Display Order</label>
                        <input asp-for="DisplayOrder" type="number" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none" />
                    </div>
                </div>
                <div class="mt-4">
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500" />
                        <span class="text-sm font-semibold text-slate-700">Display this service publicly on the website</span>
                    </label>
                </div>
            </div>

            <!-- Section: Media & Imagery -->
            <div class="pt-6 border-t border-slate-200">
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-4">3. Media & Image</h3>
                <div>
                    <label asp-for="ImageFile" class="block text-xs font-bold text-slate-700 mb-1">Upload Service Image</label>
                    <input asp-for="ImageFile" type="file" accept="image/*" class="text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200" />
                    <p class="text-xs text-slate-400 mt-1">Image will be automatically converted to optimized WebP format.</p>
                </div>
            </div>

            <!-- Section: SEO Meta -->
            <div class="pt-6 border-t border-slate-200">
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-4">4. Search Engine Optimization (SEO)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div>
                            <label asp-for="SlugDe" class="block text-xs font-bold text-slate-700 mb-1">URL Slug (German)</label>
                            <input asp-for="SlugDe" placeholder="e.g. autowaesche-berlin" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none" />
                        </div>
                        <div>
                            <label asp-for="SeoTitleDe" class="block text-xs font-bold text-slate-700 mb-1">SEO Title (German)</label>
                            <input asp-for="SeoTitleDe" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none" />
                        </div>
                        <div>
                            <label asp-for="MetaDescriptionDe" class="block text-xs font-bold text-slate-700 mb-1">Meta Description (German)</label>
                            <textarea asp-for="MetaDescriptionDe" rows="2" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none"></textarea>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label asp-for="SlugEn" class="block text-xs font-bold text-slate-700 mb-1">URL Slug (English)</label>
                            <input asp-for="SlugEn" placeholder="e.g. car-wash-berlin" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none" />
                        </div>
                        <div>
                            <label asp-for="SeoTitleEn" class="block text-xs font-bold text-slate-700 mb-1">SEO Title (English)</label>
                            <input asp-for="SeoTitleEn" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none" />
                        </div>
                        <div>
                            <label asp-for="MetaDescriptionEn" class="block text-xs font-bold text-slate-700 mb-1">Meta Description (English)</label>
                            <textarea asp-for="MetaDescriptionEn" rows="2" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-600 focus:outline-none"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-200 flex items-center justify-end gap-3">
                <a href="/Admin/Services" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-sm font-semibold transition-colors">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-sm font-bold shadow-md shadow-brand-600/20 transition-all">
                    Save Service
                </button>
            </div>
        </form>
    </div>
</div>
