@model CarWashWebsite.ViewModels.Admin.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard Overview";
}

<!-- Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Services</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1">@Model.TotalServices</div>
            <div class="text-xs text-emerald-600 font-semibold mt-1">@Model.ActiveServices active on website</div>
        </div>
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Unread Inquiries</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1">@Model.UnreadMessages</div>
            <div class="text-xs text-slate-500 font-medium mt-1">Contact form messages</div>
        </div>
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Gallery Projects</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1">@Model.TotalGalleryItems</div>
            <div class="text-xs text-slate-500 font-medium mt-1">Before / After items</div>
        </div>
        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Frequently Asked Questions</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1">@Model.TotalFaqs</div>
            <div class="text-xs text-slate-500 font-medium mt-1">Active customer FAQs</div>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
    </div>
</div>

<!-- Fast Quick Actions & Management Links -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-slate-900">Services & Price Management</h2>
            <a href="/Admin/Services" class="text-xs font-semibold text-brand-600 hover:text-brand-700">View All &rarr;</a>
        </div>
        <p class="text-sm text-slate-600 mb-6">
            Easily update prices (Fixed, Starting From, On Request), edit German/English descriptions, configure SEO metadata, and add service imagery without touching code.
        </p>
        <div class="flex flex-wrap gap-3">
            <a href="/Admin/Services" class="px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-sm font-bold shadow-md shadow-brand-600/20 transition-all">
                Manage Services & Prices
            </a>
            <a href="/Admin/Services/Create" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold transition-all">
                + Add New Service
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-base font-bold text-slate-900 mb-4">System Status</h2>
        <dl class="divide-y divide-slate-100 text-sm">
            <div class="py-2.5 flex justify-between">
                <dt class="text-slate-500">Framework</dt>
                <dd class="font-semibold text-slate-800">.NET 10.0</dd>
            </div>
            <div class="py-2.5 flex justify-between">
                <dt class="text-slate-500">Database</dt>
                <dd class="font-semibold text-slate-800">SQL Server</dd>
            </div>
            <div class="py-2.5 flex justify-between">
                <dt class="text-slate-500">Localization</dt>
                <dd class="font-semibold text-slate-800">German & English</dd>
            </div>
            <div class="py-2.5 flex justify-between">
                <dt class="text-slate-500">Image Processor</dt>
                <dd class="font-semibold text-slate-800">ImageSharp (WebP)</dd>
            </div>
        </dl>
    </div>
</div>
