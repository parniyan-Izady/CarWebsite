@model CarWashWebsite.ViewModels.Admin.ChangePasswordViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Change Password";
}

<div class="max-w-xl mx-auto">
    <div class="card shadow-sm">
        <div class="mb-6 pb-4 border-b border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">Update Administrator Password</h2>
            <p class="text-slate-500 text-sm mt-1">Ensure your account uses a strong, unique password of at least 8 characters.</p>
        </div>

        <form asp-area="Admin" asp-controller="Account" asp-action="ChangePassword" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-red-50 text-red-700 text-sm border border-red-200"></div>

            <div>
                <label asp-for="CurrentPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Current Password</label>
                <input asp-for="CurrentPassword" class="input-field" placeholder="••••••••" required />
                <span asp-validation-for="CurrentPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">New Password</label>
                <input asp-for="NewPassword" class="input-field" placeholder="••••••••" required />
                <span asp-validation-for="NewPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="input-field" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <a href="/Admin/Dashboard" class="btn-secondary !text-slate-700 !border-slate-300 hover:!bg-slate-100 !text-sm !py-2.5">
                    Cancel
                </a>
                <button type="submit" class="btn-primary !text-sm !py-2.5">
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>
