@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Page Content Management";
}

<div class="space-y-6">
    <div>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Website Page Content</h2>
        <p class="text-slate-500 text-sm mt-1">Select a page section below to update titles, marketing copy, features, and rich text.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Home Page Card -->
        <a href="/Admin/Pages/Home" class="card hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
            <div>
                <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">Home Page</h3>
                <p class="text-slate-500 text-xs mt-1 leading-relaxed">
                    Hero headline &amp; subtitle, Why Choose Us points, and primary call-to-action bands.
                </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-brand-600">
                <span>Edit Content</span>
                <span>&rarr;</span>
            </div>
        </a>

        <!-- About Page Card -->
        <a href="/Admin/Pages/About" class="card hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
            <div>
                <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">About Page</h3>
                <p class="text-slate-500 text-xs mt-1 leading-relaxed">
                    Studio craftsmanship statement, equipment standards, and certified materials via CKEditor.
                </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-brand-600">
                <span>Edit Content</span>
                <span>&rarr;</span>
            </div>
        </a>

        <!-- Legal Pages Card -->
        <a href="/Admin/Pages/Legal" class="card hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
            <div>
                <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">Impressum &amp; Privacy</h3>
                <p class="text-slate-500 text-xs mt-1 leading-relaxed">
                    German Telemedia Act disclosures and GDPR-compliant privacy policies in DE and EN.
                </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-brand-600">
                <span>Edit Content</span>
                <span>&rarr;</span>
            </div>
        </a>

        <!-- Footer Card -->
        <a href="/Admin/Pages/Footer" class="card hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
            <div>
                <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">Footer</h3>
                <p class="text-slate-500 text-xs mt-1 leading-relaxed">
                    Studio description tagline and copyright notice displayed across every page footer.
                </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-brand-600">
                <span>Edit Content</span>
                <span>&rarr;</span>
            </div>
        </a>
    </div>
</div>
