@model CarWashWebsite.ViewModels.Admin.SeoManagementViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Search Engine Optimization (SEO)";
}

<div class="space-y-6">
    <!-- Header & Quick Sitemap links -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">SEO &amp; Meta Management</h2>
            <p class="text-slate-500 text-sm mt-1">Configure search engine titles, meta descriptions, and inspect live SERP previews.</p>
        </div>

        <div class="flex items-center gap-2">
            <a href="@Model.SitemapUrl" target="_blank" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 flex items-center gap-1.5 shadow-sm transition-colors">
                <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                <span>sitemap.xml</span>
            </a>
            <a href="@Model.RobotsUrl" target="_blank" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 flex items-center gap-1.5 shadow-sm transition-colors">
                <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>robots.txt</span>
            </a>
        </div>
    </div>

    <!-- Page Selection Tabs -->
    <div class="flex flex-wrap items-center gap-2 bg-white p-2 rounded-2xl border border-slate-200 shadow-sm">
        @foreach (var p in Model.Pages)
        {
            <a href="/Admin/Seo?page=@p.PageKey" class="px-4 py-2 rounded-xl text-xs font-bold transition-all @(Model.SelectedPageKey == p.PageKey ? "bg-brand-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                @p.PageName
            </a>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Edit Form (7 cols on lg+) -->
        <div class="lg:col-span-7">
            <div class="card shadow-sm space-y-6">
                <div class="border-b border-slate-100 pb-4">
                    <h3 class="text-lg font-bold text-slate-900">SEO Settings: @Model.CurrentPage.PageName</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Route paths: <span class="font-mono text-slate-700">@Model.CurrentPage.PathDe</span> | <span class="font-mono text-slate-700">@Model.CurrentPage.PathEn</span></p>
                </div>

                <form asp-area="Admin" asp-controller="Seo" asp-action="Save" method="post" class="space-y-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PageKey" value="@Model.CurrentPage.PageKey" />
                    <input type="hidden" name="PageName" value="@Model.CurrentPage.PageName" />
                    <input type="hidden" name="PathDe" value="@Model.CurrentPage.PathDe" />
                    <input type="hidden" name="PathEn" value="@Model.CurrentPage.PathEn" />

                    <!-- German SEO -->
                    <div class="space-y-4 p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <span class="badge bg-brand-100 text-brand-700 font-bold">German (DE)</span>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">SEO Title (DE)</label>
                            <input id="seoTitleDe" name="SeoTitleDe" value="@Model.CurrentPage.SeoTitleDe" class="input-field" maxlength="100" />
                            <div class="text-[11px] text-slate-400 mt-1 flex justify-between">
                                <span>Recommended: 50-60 characters</span>
                                <span id="titleDeCount">@(Model.CurrentPage.SeoTitleDe?.Length ?? 0) / 100</span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Meta Description (DE)</label>
                            <textarea id="metaDescDe" name="MetaDescriptionDe" rows="3" class="input-field" maxlength="320">@Model.CurrentPage.MetaDescriptionDe</textarea>
                            <div class="text-[11px] text-slate-400 mt-1 flex justify-between">
                                <span>Recommended: 140-160 characters</span>
                                <span id="descDeCount">@(Model.CurrentPage.MetaDescriptionDe?.Length ?? 0) / 320</span>
                            </div>
                        </div>
                    </div>

                    <!-- English SEO -->
                    <div class="space-y-4 p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <span class="badge bg-slate-200 text-slate-700 font-bold">English (EN)</span>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">SEO Title (EN)</label>
                            <input name="SeoTitleEn" value="@Model.CurrentPage.SeoTitleEn" class="input-field" maxlength="100" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Meta Description (EN)</label>
                            <textarea name="MetaDescriptionEn" rows="3" class="input-field" maxlength="320">@Model.CurrentPage.MetaDescriptionEn</textarea>
                        </div>
                    </div>

                    <div class="flex items-center justify-end">
                        <button type="submit" class="btn-primary !px-8 !py-2.5">
                            Save Metadata
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Google SERP Snippet Preview (5 cols on lg+) -->
        <div class="lg:col-span-5 space-y-6">
            <div class="card shadow-sm space-y-4">
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>
                    <span>Google Search Preview</span>
                </h3>
                <p class="text-xs text-slate-500 leading-relaxed">
                    This is an approximation of how this page appears in Google search engine result pages.
                </p>

                <!-- Mock Google SERP Result Card -->
                <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-1.5 shadow-sm font-sans">
                    <div class="flex items-center gap-2 text-xs text-slate-700">
                        <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center font-bold text-[10px] text-brand-600">
                            BC
                        </div>
                        <div class="leading-tight">
                            <div class="text-[11px] font-medium text-slate-800">Berlin Car Care</div>
                            <div class="text-[10px] text-slate-400">https://berlincarcare.de@(Model.CurrentPage.PathDe)</div>
                        </div>
                    </div>

                    <h4 id="previewTitle" class="text-base font-medium text-blue-800 hover:underline cursor-pointer leading-snug">
                        @Model.CurrentPage.SeoTitleDe
                    </h4>

                    <p id="previewDesc" class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                        @Model.CurrentPage.MetaDescriptionDe
                    </p>
                </div>
            </div>

            <!-- SEO Checklist Card -->
            <div class="rounded-2xl bg-navy-900 text-white p-6 border border-navy-800 space-y-3 text-xs">
                <h4 class="font-bold text-white text-sm">Automated Optimization Rules</h4>
                <ul class="space-y-2 text-slate-300">
                    <li class="flex items-center gap-2">
                        <span class="text-emerald-400 font-bold">&#10003;</span>
                        <span>Canonical link tags injected per culture automatically.</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="text-emerald-400 font-bold">&#10003;</span>
                        <span>Bidirectional `hreflang="de"` and `hreflang="en"` tags included.</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="text-emerald-400 font-bold">&#10003;</span>
                        <span>Automated schema.org JSON-LD LocalBusiness structured data.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    const titleInput = document.getElementById('seoTitleDe');
    const descInput = document.getElementById('metaDescDe');
    const previewTitle = document.getElementById('previewTitle');
    const previewDesc = document.getElementById('previewDesc');
    const titleCount = document.getElementById('titleDeCount');
    const descCount = document.getElementById('descDeCount');

    if (titleInput && previewTitle) {
        titleInput.addEventListener('input', () => {
            previewTitle.textContent = titleInput.value || 'Berlin Car Care';
            titleCount.textContent = `${titleInput.value.length} / 100`;
        });
    }

    if (descInput && previewDesc) {
        descInput.addEventListener('input', () => {
            previewDesc.textContent = descInput.value || 'Professionelle Fahrzeugaufbereitung...';
            descCount.textContent = `${descInput.value.length} / 320`;
        });
    }
</script>
