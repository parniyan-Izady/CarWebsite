@using CarWashWebsite.Data.Entities
@model IEnumerable<CarWashWebsite.Data.Entities.GalleryItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Before & After Gallery";
    var selectedCat = (GalleryCategory?)ViewBag.SelectedCategory;
}

<div class="space-y-6">
    <!-- Header & Category Filter -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Before / After Gallery</h2>
            <p class="text-slate-500 text-sm mt-1">Manage project transformations, vehicle categories, and comparison images.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <!-- Category Filter Dropdown -->
            <div class="relative">
                <select onchange="location = this.value;" class="input-field !py-2 !text-xs !w-auto pr-8">
                    <option value="/Admin/Gallery" selected="@(!selectedCat.HasValue)">All Categories</option>
                    @foreach (GalleryCategory cat in Enum.GetValues(typeof(GalleryCategory)))
                    {
                        <option value="/Admin/Gallery?category=@cat" selected="@(selectedCat == cat)">@cat</option>
                    }
                </select>
            </div>

            <a href="/Admin/Gallery/Create" class="btn-primary !py-2.5 !px-4 !text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>Add Transformation</span>
            </a>
        </div>
    </div>

    <!-- Gallery Grid -->
    @if (!Model.Any())
    {
        <div class="card text-center !py-16">
            <h3 class="text-lg font-bold text-slate-800">No transformations found</h3>
            <p class="text-slate-500 text-sm mt-1">Upload your first Before &amp; After photo comparison to showcase studio results.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
                <div class="card !p-0 overflow-hidden shadow-sm flex flex-col justify-between">
                    <!-- Before / After split thumbnail -->
                    <div>
                        <div class="grid grid-cols-2 gap-0.5 bg-slate-200">
                            <div class="relative aspect-video">
                                <span class="absolute top-2 left-2 bg-black/70 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">BEFORE</span>
                                <img src="@item.BeforeImagePath" alt="Before" class="w-full h-full object-cover" />
                            </div>
                            <div class="relative aspect-video">
                                <span class="absolute top-2 left-2 bg-brand-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">AFTER</span>
                                <img src="@item.AfterImagePath" alt="After" class="w-full h-full object-cover" />
                            </div>
                        </div>

                        <div class="p-5">
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <span class="badge bg-slate-100 text-slate-700">@item.Category</span>
                                <span class="text-xs font-semibold text-slate-400">Order: #@item.DisplayOrder</span>
                            </div>
                            <h3 class="font-bold text-slate-900 text-base">@item.TitleDe</h3>
                            <p class="text-xs text-slate-500 mt-0.5">@item.TitleEn</p>
                        </div>
                    </div>

                    <!-- Footer Row with actions -->
                    <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                        <form asp-area="Admin" asp-controller="Gallery" asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold cursor-pointer @(item.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-600 border border-slate-300")">
                                <span class="w-1.5 h-1.5 rounded-full @(item.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                <span>@(item.IsActive ? "Active" : "Hidden")</span>
                            </button>
                        </form>

                        <div class="flex items-center gap-2">
                            <a href="/Admin/Gallery/Edit/@item.Id" class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-colors">
                                Edit
                            </a>
                            <form asp-area="Admin" asp-controller="Gallery" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this gallery item?');" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors" title="Delete">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
