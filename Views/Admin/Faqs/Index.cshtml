@model IEnumerable<CarWashWebsite.Data.Entities.FaqItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "FAQ Management";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Frequently Asked Questions</h2>
            <p class="text-slate-500 text-sm mt-1">Manage questions and answers displayed in the public FAQ section.</p>
        </div>
        <a href="/Admin/Faqs/Create" class="btn-primary !py-2.5 !px-4 !text-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Add New FAQ</span>
        </a>
    </div>

    <!-- Table -->
    @if (!Model.Any())
    {
        <div class="card text-center !py-16">
            <h3 class="text-lg font-bold text-slate-800">No FAQ items yet</h3>
            <p class="text-slate-500 text-sm mt-1">Click "Add New FAQ" to create your first question and answer.</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-500 uppercase text-[11px] font-bold tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-4">Order</th>
                            <th class="px-6 py-4">Question (German / English)</th>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var faq in Model)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 text-slate-500 font-bold">
                                    #@faq.DisplayOrder
                                </td>
                                <td class="px-6 py-4 max-w-md">
                                    <div class="font-bold text-slate-900">@faq.QuestionDe</div>
                                    <div class="text-xs text-slate-500 mt-0.5">@faq.QuestionEn</div>
                                </td>
                                <td class="px-6 py-4">
                                    <form asp-area="Admin" asp-controller="Faqs" asp-action="ToggleStatus" asp-route-id="@faq.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold cursor-pointer transition-colors @(faq.IsActive ? "bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200" : "bg-slate-100 text-slate-600 hover:bg-slate-200 border border-slate-300")">
                                            <span class="w-1.5 h-1.5 rounded-full @(faq.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                            <span>@(faq.IsActive ? "Active" : "Inactive")</span>
                                        </button>
                                    </form>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/Admin/Faqs/Edit/@faq.Id" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-colors">
                                            Edit
                                        </a>
                                        <form asp-area="Admin" asp-controller="Faqs" asp-action="Delete" asp-route-id="@faq.Id" method="post" onsubmit="return confirm('Delete this FAQ item?');" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors" title="Delete">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
