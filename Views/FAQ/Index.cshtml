@model IEnumerable<CarWashWebsite.Data.Entities.FaqItem>
@{
    var culture = (string?)ViewData["CurrentCulture"] ?? "de";
    var isEn = culture.Equals("en", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isEn ? "Frequently Asked Questions (FAQ)" : "Häufig gestellte Fragen (FAQ)";
}

<!-- Page Header -->
<section class="bg-navy-900 text-white py-16 lg:py-20 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-navy-800 text-brand-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-navy-700">
                FAQ
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
                @(isEn ? "Frequently Asked Questions" : "Häufig gestellte Fragen (FAQ)")
            </h1>
            <p class="mt-4 text-slate-300 text-base sm:text-lg leading-relaxed">
                @(isEn ? "Everything you need to know about our vehicle detailing, bookings, and treatments." : "Hier finden Sie Antworten auf die wichtigsten Fragen zu unseren Leistungen und Abläufen.")
            </p>
        </div>
    </div>
</section>

<!-- Accordion Section -->
<section class="py-16 lg:py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-4">
            @foreach (var faq in Model)
            {
                var q = isEn ? faq.QuestionEn : faq.QuestionDe;
                var a = isEn ? faq.AnswerEn : faq.AnswerDe;

                <details class="card hover:shadow-md transition-shadow duration-200 group">
                    <summary class="flex items-center justify-between font-semibold text-lg text-slate-900 list-none cursor-pointer select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-lg py-1">
                        <span class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </span>
                            <span>@q</span>
                        </span>
                        <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </summary>
                    <div class="mt-4 pt-4 border-t border-slate-100 pl-11">
                        <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                            @a
                        </p>
                    </div>
                </details>
            }
        </div>
    </div>
</section>
