@using CarWashWebsite.Data.Entities
@model IEnumerable<CarWashWebsite.Data.Entities.Service>
@{
    var culture = (string?)ViewData["CurrentCulture"] ?? "de";
    var isEn = culture.Equals("en", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isEn ? "All Car Care & Detailing Services" : "Alle Dienstleistungen & Preise";
}

<!-- Page Header -->
<section class="bg-navy-900 text-white py-16 lg:py-20 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-navy-800 text-brand-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-navy-700">
                @(isEn ? "Premium Services" : "Erstklassige Leistungen")
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
                @(isEn ? "Our Automotive Services & Pricing" : "Unsere Dienstleistungen & Preise")
            </h1>
            <p class="mt-4 text-slate-300 text-base sm:text-lg leading-relaxed">
                @(isEn ? "Transparent pricing, high-end materials, and meticulous craftsmanship for every vehicle model." : "Transparente Preise, modernste Werkzeuge und Liebe zum Detail für jedes Fahrzeug.")
            </p>
        </div>
    </div>
</section>

<!-- Services Catalog Grid -->
<section class="py-16 lg:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var s in Model)
            {
                var title = isEn ? s.TitleEn : s.TitleDe;
                var desc = isEn ? s.DescriptionEn : s.DescriptionDe;
                var slug = isEn ? s.SlugEn : s.SlugDe;

                <a href="/@culture/services/@slug" class="card hover:shadow-md transition-all duration-200 flex flex-col justify-between group block cursor-pointer">
                    <div>
                        <!-- Header: Title & Price -->
                        <div class="flex items-start justify-between gap-4 mb-3">
                            <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
                                @title
                            </h2>
                            <div class="text-right shrink-0">
                                @if (s.PriceType == PriceType.OnRequest)
                                {
                                    <span class="badge bg-slate-100 text-slate-700 font-semibold">
                                        @(isEn ? "On Request" : "Auf Anfrage")
                                    </span>
                                }
                                else if (s.PriceType == PriceType.StartingFrom)
                                {
                                    <span class="text-brand-600 font-semibold text-lg">
                                        @(isEn ? "from" : "ab") €@(s.Price?.ToString("N2") ?? "0.00")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-brand-600 font-semibold text-lg">
                                        €@(s.Price?.ToString("N2") ?? "0.00")
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Description -->
                        <p class="text-slate-600 text-sm leading-relaxed mb-6">
                            @desc
                        </p>
                    </div>

                    <!-- Divider & Footer Row -->
                    <div class="border-t border-slate-100 pt-4 mt-auto flex items-center justify-between">
                        <span class="text-brand-600 font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                            <span>@(isEn ? "Details & Booking" : "Details & Buchen")</span>
                            <span aria-hidden="true">→</span>
                        </span>
                        <span class="text-slate-400 text-sm">
                            @(isEn ? "Berlin Workshop" : "Werkstatt Berlin")
                        </span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>
