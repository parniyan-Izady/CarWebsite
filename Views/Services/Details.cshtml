@using CarWashWebsite.Data.Entities
@model CarWashWebsite.ViewModels.Public.ServiceDetailViewModel
@{
    var isEn = Model.CurrentCulture.Equals("en", StringComparison.OrdinalIgnoreCase);
    var title = isEn ? Model.Service.TitleEn : Model.Service.TitleDe;
    var desc = isEn ? Model.Service.DescriptionEn : Model.Service.DescriptionDe;
    var seoTitle = isEn ? Model.Service.SeoTitleEn : Model.Service.SeoTitleDe;
    var metaDesc = isEn ? Model.Service.MetaDescriptionEn : Model.Service.MetaDescriptionDe;

    ViewData["Title"] = string.IsNullOrWhiteSpace(seoTitle) ? title : seoTitle;
    ViewData["MetaDescription"] = metaDesc;
}

<div class="bg-navy-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex text-xs text-slate-400 mb-4 gap-2">
            <a href="/@Model.CurrentCulture" class="hover:text-white">@(isEn ? "Home" : "Startseite")</a>
            <span>/</span>
            <a href="/@Model.CurrentCulture/services" class="hover:text-white">@(isEn ? "Services" : "Dienstleistungen")</a>
            <span>/</span>
            <span class="text-slate-200">@title</span>
        </nav>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">@title</h1>
    </div>
</div>

<div class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <!-- Left 2 columns: Description & Detailing breakdown -->
            <div class="lg:col-span-2 space-y-8">
                <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
                    <h2 class="text-xl font-bold text-slate-900 mb-4">@(isEn ? "Service Overview & Scope" : "Leistungsbeschreibung & Umfang")</h2>
                    <div class="text-slate-700 leading-relaxed space-y-4 text-base">
                        <p>@desc</p>
                    </div>

                    <div class="mt-8 pt-8 border-t border-slate-100">
                        <h3 class="font-bold text-slate-900 text-base mb-4">@(isEn ? "What is included?" : "Was beinhaltet diese Leistung?")</h3>
                        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-600">
                            <li class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-brand-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                @(isEn ? "Pre-inspection of vehicle condition" : "Sorgfältige Vorab-Zustandsprüfung")
                            </li>
                            <li class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-brand-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                @(isEn ? "Certified eco-friendly materials" : "Schonende & umweltgerechte Markenprodukte")
                            </li>
                            <li class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-brand-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                @(isEn ? "Professional execution by experts" : "Fachgerechte Ausführung durch Profis")
                            </li>
                            <li class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-brand-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                @(isEn ? "Final quality inspection" : "Abschließende Qualitätskontrolle")
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Column: Booking & Price Sidebar -->
            <div class="space-y-6">
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                    <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
                        @(isEn ? "Pricing" : "Preise")
                    </div>
                    <div class="mb-6">
                        @if (Model.Service.PriceType == PriceType.OnRequest)
                        {
                            <div class="text-2xl font-black text-slate-900">@(isEn ? "On Request" : "Auf Anfrage")</div>
                            <div class="text-xs text-slate-500 mt-1">@(isEn ? "Custom quote depending on vehicle size & dirt level" : "Individuelles Angebot je nach Fahrzeugzustand")</div>
                        }
                        else if (Model.Service.PriceType == PriceType.StartingFrom)
                        {
                            <div class="text-3xl font-black text-brand-600">ab €@(Model.Service.Price?.ToString("N2") ?? "0.00")</div>
                            <div class="text-xs text-slate-500 mt-1">@(isEn ? "Starting price based on vehicle class" : "Grundpreis je nach Fahrzeugklasse")</div>
                        }
                        else
                        {
                            <div class="text-3xl font-black text-slate-900">€@(Model.Service.Price?.ToString("N2") ?? "0.00")</div>
                            <div class="text-xs text-slate-500 mt-1">@(isEn ? "Fixed transparent rate" : "Fester transparenter Pauschalpreis")</div>
                        }
                    </div>

                    <a href="/@Model.CurrentCulture/contact?subject=@Uri.EscapeDataString(title)" class="block w-full py-3.5 text-center font-bold text-white bg-brand-600 hover:bg-brand-500 rounded-xl shadow-lg shadow-brand-600/20 transition-all text-sm mb-3">
                        @(isEn ? "Book or Inquire This Service" : "Diesen Service anfragen")
                    </a>
                    <a href="tel:+493012345678" class="block w-full py-2.5 text-center font-semibold text-slate-700 hover:bg-slate-100 rounded-xl border border-slate-200 text-xs transition-colors">
                        @(isEn ? "Call Us: +49 30 12345678" : "Telefonisch: +49 30 12345678")
                    </a>
                </div>

                <!-- Workshop Info -->
                <div class="bg-navy-950 text-white rounded-2xl p-6">
                    <h4 class="font-bold text-sm mb-2">Berlin Car Care</h4>
                    <p class="text-xs text-slate-400 mb-4">Kurfürstendamm 120, 10711 Berlin</p>
                    <div class="text-xs text-slate-300">
                        <span class="text-brand-400 font-semibold">Mo - Sa:</span> 08:00 - 18:00 Uhr
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
