@using CarWashWebsite.Data.Entities
@model IEnumerable<CarWashWebsite.Data.Entities.GalleryItem>
@{
    var culture = (string?)ViewData["CurrentCulture"] ?? "de";
    var isEn = culture.Equals("en", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isEn ? "Before & After Transformation Gallery" : "Vorher / Nachher Galerie";
}

<!-- Page Header -->
<section class="bg-navy-900 text-white py-16 lg:py-20 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-navy-800 text-brand-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-navy-700">
                @(isEn ? "Transformations" : "Ergebnisse")
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
                @(isEn ? "Before & After Transformations" : "Vorher / Nachher Galerie")
            </h1>
            <p class="mt-4 text-slate-300 text-base sm:text-lg leading-relaxed">
                @(isEn
                    ? "See real results from our Berlin studio: paint correction, interior revitalizations, and showroom-ready finishes."
                    : "Erleben Sie die sichtbaren Resultate unserer Arbeit: Lackaufbereitung, Polster-Tiefenreinigung und makelloser Glanz.")
            </p>
        </div>
    </div>
</section>

<!-- Gallery Grid Section -->
<section class="py-16 lg:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (!Model.Any())
        {
            <!-- Empty state: centered card with icon, heading, subtext -->
            <div class="max-w-xl mx-auto text-center card !p-12 shadow-sm border border-slate-200">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 mx-auto flex items-center justify-center mb-5">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-900 mb-2">
                    @(isEn ? "Projects are currently being updated" : "Galerie-Bilder werden aktuell eingepflegt")
                </h2>
                <p class="text-slate-500 text-sm max-w-sm mx-auto leading-relaxed">
                    @(isEn ? "New high-resolution before/after projects will appear here shortly." : "In Kürze finden Sie hier neue Vorher-/Nachher-Aufnahmen unserer Aufbereitungen.")
                </p>
                <div class="mt-6">
                    <a href="/@culture/contact" class="btn-primary !px-5 !py-2.5 !text-sm">
                        @(isEn ? "Book Your Transformation" : "Termin vereinbaren")
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Grid: 1 col on mobile, 2 cols on md, 3 cols on lg, gap-6 -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var item in Model)
                {
                    var title = isEn ? item.TitleEn : item.TitleDe;
                    var desc = isEn ? item.DescriptionEn : item.DescriptionDe;

                    <div class="card !p-0 overflow-hidden hover:shadow-card-hover transition-all duration-300 flex flex-col group">
                        <!-- Before & After Comparison Split -->
                        <div class="grid grid-cols-2 gap-0.5 bg-slate-200">
                            <div class="relative aspect-video overflow-hidden">
                                <span class="absolute top-2 left-2 z-10 bg-navy-950/80 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-0.5 rounded tracking-wider">
                                    @(isEn ? "BEFORE" : "VORHER")
                                </span>
                                <img src="@item.BeforeImagePath" alt="Before" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                            </div>
                            <div class="relative aspect-video overflow-hidden">
                                <span class="absolute top-2 left-2 z-10 bg-brand-600/90 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-0.5 rounded tracking-wider">
                                    @(isEn ? "AFTER" : "NACHHER")
                                </span>
                                <img src="@item.AfterImagePath" alt="After" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-6 flex-grow flex flex-col justify-between">
                            <div>
                                <h2 class="font-bold text-lg text-slate-900 mb-1 group-hover:text-brand-600 transition-colors">
                                    @title
                                </h2>
                                <p class="text-sm text-slate-600 leading-relaxed">
                                    @desc
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
